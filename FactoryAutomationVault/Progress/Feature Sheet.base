views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Progress/Features")
    groupBy:
      property: Age
      direction: ASC
    groupOrder:
      - Stone
      - Copper
      - Iron
      - Bronze
    order:
      - file.name
      - Age
      - Logic
      - Texture
      - Model
      - BlockState
      - Localization
      - Sound
      - Recipe
      - Drops
      - Worldgen
      - tags
    sort: []
    columnSize:
      note.Age: 92
